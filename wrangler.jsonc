{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // deploy.sh rewrites this to https://<worker>.<subdomain>.workers.dev/mcp
    "MCP_RESOURCE": "http://localhost:8787/mcp",
    // comma-separated browser Origin hostnames allowed to call /mcp (fill in once Muse's origin is known)
    "ALLOWED_ORIGIN_HOSTNAMES": "",
    // comma-separated OAuth redirect hosts allowed (empty = any registered client)
    "ALLOWED_REDIRECT_HOSTS": ""
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muse-bridge",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
