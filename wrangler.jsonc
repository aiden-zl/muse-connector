{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // deploy.sh rewrites this to https://<worker>.<subdomain>.workers.dev/mcp
    "MCP_RESOURCE": "https://muse-bridge.aleong700-c87.workers.dev/mcp",
    // comma-separated browser Origin hostnames allowed to call /mcp (fill in once Muse's origin is known)
    "ALLOWED_ORIGIN_HOSTNAMES": "",
    // comma-separated OAuth redirect hosts allowed (empty = any registered client)
    "ALLOWED_REDIRECT_HOSTS": ""
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "168f680fd9a9423ba95b6f93ed007f97" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muse-bridge",
      "database_id": "14e55be4-9f72-40a6-8d74-850fc04f05fc",
      "migrations_dir": "migrations"
    }
  ]
}
